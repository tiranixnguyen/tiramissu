{
  "name": "tiramissu-backend",
  "version": "1.0.0",
  "description": "API cho app học từ vựng Hàn → Việt: nội dung + lịch sử học",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "import-content": "node -r ts-node/register/transpile-only src/scripts/importContent.ts",
    "export-content": "node -r ts-node/register/transpile-only src/scripts/exportContent.ts",
    "prune-audio": "node -r ts-node/register/transpile-only src/scripts/pruneAudio.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "prisma": "^7.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
