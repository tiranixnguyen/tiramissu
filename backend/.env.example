# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tiramissu_dev?schema=public"
PORT=3000

# Chưa có đăng nhập — mọi request đều phục vụ đúng user này (tự tạo nếu chưa
# tồn tại). Xem backend/src/modules/common/defaultUser.ts.
DEFAULT_USER_EMAIL="local@vocab-app.local"

# Dung lượng tối đa mỗi file nghe (byte), mặc định 2097152 (2 MB ~ 2 phút MP3
# 128 kbps). Xem backend/src/modules/audio/audioService.ts.
AUDIO_MAX_BYTES=2097152
